"""Collect the forms and text-input reference of Streamlit 1.66.1.

    python tests/browser/forms_capture.py --url http://127.0.0.1:8606 \
        --label python-forms --out tests/reference/reference-browser/forms

WHAT THIS RECORDS
    * every bidirectional WebSocket frame of the official 1.66.1 frontend,
      with the raw protobuf payload, its sha256, the DevTools request id of
      the socket it travelled on and the decoded summary of the official
      protobuf definitions.
    * the DOM before and after every action: the rendered counters, the value
      of every text input, the state of every checkbox, the buttons, the
      exception the page shows and the alerts.
    * a screenshot of every phase, with the bytes and the sha256 of the PNG
      the browser produced.

WHAT THIS IS NOT
    It states no verdict.  It records what the reference runtime did; the
    strict criterion is the author's, and it reads this file.  Nothing here
    decides whether a case passed, and no field is filled in to make a case
    look good: a missing observation is written as missing.

BROWSER
    The collector starts its own Chrome on its own DevTools port with its own
    profile directory, so it shares no window, no focus, no scroll position
    and no session with another capture.  The recorder is attached to the
    page before the first navigation, so the WebSocket handshake is part of
    the trace.  The page is opened with an ``agent-browser`` named session
    bound to that same Chrome over CDP, so both tools drive one browser
    instance, and the frames are read from the DevTools endpoint of that very
    instance.  When the agent-browser CLI cannot drive the page, the reason
    is written into the trace and the navigation falls back to the DevTools
    Protocol; nothing is invented.
"""

from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile
import traceback
import time
import urllib.request
from urllib.parse import quote
from datetime import datetime, timezone

HERE = pathlib.Path(__file__).resolve().parent
ROOT = HERE.parents[1]
sys.path.insert(0, str(ROOT / "tests" / "reference"))
sys.path.insert(0, str(HERE))

from capture_browser_trace import (  # noqa: E402  (path setup must precede the import)
    CDP,
    _safe,
    http_requests_from_events,
    require_decoder,
    summarise_back,
    summarise_forward,
)
from numeric_capture import Page  # noqa: E402  the proven CDP input helper
from forms_cases import CASES  # noqa: E402  the one canonical case list
from forms_contract import (  # noqa: E402  the strict contract owns these
    NAMESPACE,
